# Docker Compose: required. Use long random values with letters and digits only (they are placed in URLs).
POSTGRES_PASSWORD=
READER_PASSWORD=

# Running the backend without Compose (e.g. Render + Neon):
# DATABASE_URL       -> read-only reader role; the only URL the API needs
# ADMIN_DATABASE_URL -> owner role; only for `python -m app.setup_db`, never on the API service
# DATABASE_URL=postgresql+psycopg://datatalk_reader:<password>@<host>:5432/datatalk
# ADMIN_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<host>:5432/datatalk

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
MAX_RESULT_ROWS=200
STATEMENT_TIMEOUT_MS=5000

# Comma-separated frontend origins allowed to call the API (e.g. your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_QUERIES=4
ENABLE_EVAL_ENDPOINT=false
