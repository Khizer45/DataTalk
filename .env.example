# Docker Compose: required. Use long random values with letters and digits only (they are placed in URLs).
POSTGRES_PASSWORD=
READER_PASSWORD=
# Role used only to import CSV uploads into the 'uploads' schema.
INGEST_PASSWORD=

# Running the backend without Compose (e.g. Render + Neon):
# DATABASE_URL       -> read-only reader role; the only URL the API needs
# ADMIN_DATABASE_URL -> owner role; only for `python -m app.setup_db`, never on the API service
# INGEST_DATABASE_URL -> optional; enables CSV uploads (role limited to the 'uploads' schema)
# DATABASE_URL=postgresql+psycopg://datatalk_reader:<password>@<host>:5432/datatalk
# ADMIN_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<host>:5432/datatalk
# INGEST_DATABASE_URL=postgresql+psycopg://datatalk_ingest:<password>@<host>:5432/datatalk

# Optional: a different business context file (table/column meanings, glossary, examples).
# BUSINESS_CONTEXT_PATH=

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# AI answers per UTC day before falling back to demo mode (0 = no cap). Also set a spending limit with your provider.
LLM_DAILY_LIMIT=200
MAX_RESULT_ROWS=200
STATEMENT_TIMEOUT_MS=5000

# Comma-separated frontend origins allowed to call the API (e.g. your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_QUERIES=4

# CSV uploads (only used when INGEST_DATABASE_URL is set)
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=50000
UPLOAD_MAX_COLUMNS=50
UPLOAD_MAX_CELL_CHARS=1000
DATASET_TTL_HOURS=24
MAX_ACTIVE_DATASETS=100
UPLOAD_RATE_LIMIT_PER_MINUTE=5

# Your own PostgreSQL databases (optional; see README "Connect your own PostgreSQL database").
# Use a dedicated read-only role; DataTalk refuses roles that can write. Visitors pick these from a list,
# they never enter connection strings.
# DATA_SOURCES=sales
# SOURCE_SALES_URL=postgresql+psycopg://datatalk_readonly:<password>@<host>:5432/sales?sslmode=require
# SOURCE_SALES_LABEL=Sales database
# SOURCE_SALES_SCHEMA=public
# SOURCE_SALES_TABLES=orders,customers
# SOURCE_SALES_ACCESS_KEY=<long random key>
